rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin check: any authenticated user is treated as admin
    function isAdmin() {
      return request.auth != null;
    }

    // Orders collection:
    // - Students can submit orders from mobile/desktop
    // - Students can track their order by ID or pickup code
    // - Admin and local shop print gateway can query and update status
    // - Deletion requires admin auth
    match /orders/{orderId} {
      allow create: if true;
      allow get, list: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Gateways collection:
    // Allows shop PC print agent to send heartbeats and admin dashboard to monitor live status
    match /gateways/{gatewayId} {
      allow read, write: if true;
    }

    // Public pricing configuration so students on any device get current rates
    match /pricing/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Templates Gallery collection (Project front pages, lab reports, cover sheets)
    match /templates/{templateId} {
      allow read, write: if true;
    }

    // Admin user records
    match /users/{userId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
