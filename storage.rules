rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Admin check function
    function isAdmin() {
      return request.auth != null;
    }

    match /orders/pending/{fileId} {
      // Anyone can upload a printable document to the pending folder (50MB max)
      allow write: if request.resource.size < 50 * 1024 * 1024;
      // Allow reading so that download URLs work for preview and printing
      allow read: if true;
    }

    // Admins can read, write, and delete any file (including processed orders)
    match /{allPaths=**} {
      allow read, write, delete: if isAdmin();
    }
  }
}
